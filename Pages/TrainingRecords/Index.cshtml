@page
@model TrainingTracker.Pages.TrainingRecordPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TrainingRecord[0].EmployeeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrainingRecord[0].CourseTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrainingRecord[0].CompletedOn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrainingRecord[0].Score)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.TrainingRecord) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.EmployeeName)
            </td>
            <td>
                @Html.DisplayFor(model => item.CourseTitle)
            </td>
            <td>
                @Html.DisplayFor(model => item.CompletedOn)
            </td>
            <td>
                @Html.DisplayFor(model => item.Score)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
